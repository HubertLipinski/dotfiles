#!/bin/sh

set -e

echo "Installing packages..."

{{- if eq .chezmoi.os "linux" }}

# Required linux packages
sudo apt update
sudo apt install -y \
    wget \
    curl \
    git \
    build-essential \
    procps \
    file \
    socat \
    zsh \
    bat

# Install brew
if ! command -v brew >/dev/null 2>&1; then
    echo "Homebrew not found, installing..."
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" >> ~/brew-install.log 2>&1
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv 2>/dev/null || true)"
fi

brew install \
    fzf \
    zoxide \
    antigen \
    thefuck \
    fd \
    eza

# Install fnm (fast node manager)
if ! command -v fnm >/dev/null 2>&1; then
    echo "Installing fnm..."
    curl -fsSL https://fnm.vercel.app/install | bash
fi
export PATH="$HOME/.local/share/fnm:$PATH"
eval "$(fnm env)"
fnm install --lts
fnm default lts-latest

# Install Claude Code
npm install -g @anthropic-ai/claude-code

# Symlink antigen from brew (no separate download needed)
ln -sf "$(brew --prefix)/share/antigen/antigen.zsh" ~/antigen.zsh

# Change default shell to zsh
ZSH_PATH=$(which zsh)
if [ "$SHELL" != "$ZSH_PATH" ]; then
    # Add zsh to /etc/shells if not present (needed for brew's zsh)
    if ! grep -qx "$ZSH_PATH" /etc/shells; then
        echo "$ZSH_PATH" | sudo tee -a /etc/shells
    fi
    echo "Changing shell to zsh for $USER"
    chsh -s "$ZSH_PATH" "$USER"
fi

{{- else }}

echo "{{ .chezmoi.os }} not supported yet!"

{{- end }}
