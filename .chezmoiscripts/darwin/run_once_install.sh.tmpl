#!/bin/sh

set -e

echo "Installing packages..."

{{- if eq .chezmoi.os "darwin" }}

# Install brew
if ! command -v brew >/dev/null 2>&1; then
    echo "Homebrew not found, installing..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null || true)"
fi

brew install \
    fzf \
    zoxide \
    antigen \
    thefuck \
    fd \
    eza \
    bat \
    --cask google-cloud-sdk

# Install fnm (fast node manager)
if ! command -v fnm >/dev/null 2>&1; then
    echo "Installing fnm..."
    curl -fsSL https://fnm.vercel.app/install | bash -s -- --skip-shell
fi
export PATH="$HOME/.local/share/fnm:$PATH"
fnm install --lts
fnm default lts-latest
eval "$(fnm env --shell bash)"

# Install Claude Code
npm install -g @anthropic-ai/claude-code

# Symlink antigen from brew (no separate download needed)
ln -sf "$(brew --prefix)/share/antigen/antigen.zsh" ~/antigen.zsh

# Create antigen cache dir (prevents docker plugin cp error on first run)
mkdir -p ~/.antigen/bundles/robbyrussell/oh-my-zsh/cache/completions

{{- else }}

echo "{{ .chezmoi.os }} not supported by this script!"

{{- end }}
