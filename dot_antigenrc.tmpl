# Awesome Zsh Plugins: https://github.com/unixorn/awesome-zsh-plugins
# Antigen: https://github.com/zsh-users/antigen
# Oh My Zsh: https://github.com/ohmyzsh/ohmyzsh

# Load oh-my-zsh
antigen use oh-my-zsh

# Bundles from the default repo (robbyrussell's oh-my-zsh).
antigen bundle git
antigen bundle gitfast  # faster git completions
antigen bundle command-not-found
antigen bundle colored-man-pages  # man pages with color
antigen bundle safe-paste  # prevent any commands from running when pasted
antigen bundle dirhistory  # keyboard shortcuts to navigate directories
antigen bundle fzf # fuzzzzzy find
antigen bundle zoxide  # smarter cd command
antigen bundle npm  # npm completions
antigen bundle docker  # docker completions & aliases
antigen bundle docker-compose  # docker-compose completions & aliases

# Additional bundles
antigen bundle zsh-users/zsh-syntax-highlighting
antigen bundle zsh-users/zsh-autosuggestions
antigen bundle zsh-users/zsh-completions

antigen bundle MichaelAquilina/zsh-you-should-use  # reminds about alias for command you just ran
antigen bundle tanzim077/nestjs-cli-completion  # NestJS CLI completions

# Load the theme.
antigen theme romkatv/powerlevel10k

# Done
antigen apply

